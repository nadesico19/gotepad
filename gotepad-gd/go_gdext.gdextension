[configuration]

entry_symbol = "go_gdext_library_init"
compatibility_minimum = "4.7"

[libraries]

windows.debug.x86_64 = "res://bin/libgo_gdext.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libgo_gdext.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://bin/libgo_gdext.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://bin/libgo_gdext.windows.template_release.arm64.dll"
linux.debug.x86_64 = "res://bin/libgo_gdext.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgo_gdext.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libgo_gdext.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libgo_gdext.linux.template_release.arm64.so"
macos.debug.x86_64 = "res://bin/libgo_gdext.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://bin/libgo_gdext.macos.template_release.x86_64.dylib"
macos.debug.arm64 = "res://bin/libgo_gdext.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://bin/libgo_gdext.macos.template_release.arm64.dylib"
