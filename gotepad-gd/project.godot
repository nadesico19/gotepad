; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gotepad"
config/version="0.1.7"
run/main_scene="uid://bs3j88recurjb"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=30
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=20000
config/icon="res://assets/ui/notes.svg"

[autoload]

SettingsStore="*res://script/settings_store.gd"
CommandMessages="*res://script/command_message_localizer.gd"
DialogLayoutManager="*res://script/dialog_layout_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/handheld/orientation=4

[dotnet]

project/assembly_name="Gotepad"

[gui]

theme/custom_font="res://assets/fonts/ui_font_with_cjk_fallback.tres"

[input_devices]

pointing/android/enable_pan_and_scale_gestures=true

[internationalization]

locale/translations=PackedStringArray("res://localization/ui.zh_CN.translation", "res://localization/ui.ja.translation", "res://localization/ui.ko.translation", "res://localization/ui.en.translation")
locale/fallback="zh_CN"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
