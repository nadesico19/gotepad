[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://script/katago_analysis_panel.gd" id="1_panel"]
[ext_resource type="Script" path="res://script/analysis_control_button.gd" id="2_control_button"]
[ext_resource type="Script" path="res://script/analysis_curve.gd" id="3_curve"]

[sub_resource type="StyleBoxFlat" id="StyleBoxPanel"]
bg_color = Color(0.075, 0.075, 0.085, 0.7)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.34, 0.34, 0.38, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 8

[node name="KatagoAnalysisPanel" type="Control"]
layout_mode = 3
anchors_preset = 0
mouse_filter = 2
script = ExtResource("1_panel")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme_override_styles/panel = SubResource("StyleBoxPanel")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Content" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Controls" type="VBoxContainer" parent="Panel/Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Primary" type="HBoxContainer" parent="Panel/Margin/Content/Controls"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Play" type="Button" parent="Panel/Margin/Content/Controls/Primary"]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
focus_mode = 0
tooltip_text = "分析当前局面/恢复界面刷新"
script = ExtResource("2_control_button")
icon_kind = "play"

[node name="Pause" type="Button" parent="Panel/Margin/Content/Controls/Primary"]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
focus_mode = 0
tooltip_text = "暂停界面刷新"
script = ExtResource("2_control_button")
icon_kind = "pause"

[node name="Stop" type="Button" parent="Panel/Margin/Content/Controls/Primary"]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
focus_mode = 0
tooltip_text = "停止当前分析"
script = ExtResource("2_control_button")
icon_kind = "stop"

[node name="Spacer" type="Control" parent="Panel/Margin/Content/Controls/Primary"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Increase" type="Button" parent="Panel/Margin/Content/Controls/Primary"]
custom_minimum_size = Vector2(104, 40)
layout_mode = 2
focus_mode = 0
mouse_default_cursor_shape = 2
tooltip_text = "使用右侧指定的 maxplayouts 加大当前局面的计算量"
text = "加大计算量"

[node name="MaxPlayouts" type="SpinBox" parent="Panel/Margin/Content/Controls/Primary"]
custom_minimum_size = Vector2(158, 40)
layout_mode = 2
max_value = 1000000000.0
step = 1.0
value = 0.0
suffix = " maxplayouts"
update_on_text_changed = true

[node name="Secondary" type="HBoxContainer" parent="Panel/Margin/Content/Controls"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Status" type="Label" parent="Panel/Margin/Content/Controls/Secondary"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.78, 0.8, 0.82, 1)
theme_override_font_sizes/font_size = 13
text = "尚未开始分析"
vertical_alignment = 1
text_overrun_behavior = 3

[node name="Continuous" type="CheckBox" parent="Panel/Margin/Content/Controls/Secondary"]
layout_mode = 2
focus_mode = 0
mouse_default_cursor_shape = 2
text = "持续分析"

[node name="Candidates" type="Tree" parent="Panel/Margin/Content"]
custom_minimum_size = Vector2(280, 120)
layout_mode = 2
size_flags_vertical = 3
hide_root = true
column_titles_visible = true

[node name="Curve" type="Control" parent="Panel/Margin/Content"]
custom_minimum_size = Vector2(280, 200)
layout_mode = 2
mouse_default_cursor_shape = 2
tooltip_text = "点击曲线位置漫游到对应局面"
script = ExtResource("3_curve")

[node name="CurveFooter" type="HBoxContainer" parent="Panel/Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="WinrateLegend" type="Label" parent="Panel/Margin/Content/CurveFooter"]
layout_mode = 2
theme_override_colors/font_color = Color(0.28, 0.9, 0.48, 1)
text = "━ 黑方胜率"

[node name="ScoreLegend" type="Label" parent="Panel/Margin/Content/CurveFooter"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.78, 0.18, 1)
text = "━ 黑方目差"

[node name="FooterSpacer" type="Control" parent="Panel/Margin/Content/CurveFooter"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="AnalyzeGame" type="Button" parent="Panel/Margin/Content/CurveFooter"]
layout_mode = 2
focus_mode = 0
mouse_default_cursor_shape = 2
tooltip_text = "分析当前播放条对应的整条棋局路径"
text = "分析整条播放路径"

[node name="InvalidMaxPlayoutsDialog" type="AcceptDialog" parent="."]
title = "计算量无效"
size = Vector2i(460, 180)
dialog_text = "请输入大于 0 的 maxplayouts。"
ok_button_text = "确定"
