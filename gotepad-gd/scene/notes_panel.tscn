layout_mode = 2
focus_mode = 0
tooltip_text = "按 A-Z、a-z 顺序标记"
text = "ABC"

[node name="Triangle" type="Button" parent="Panel/Margin/Content/MarkButtons"]
custom_minimum_size = Vector2(42, 42)
layout_mode = 2
