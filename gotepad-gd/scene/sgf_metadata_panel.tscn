[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://script/sgf_metadata_panel.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxPanel"]
bg_color = Color(0.075, 0.075, 0.085, 0.5)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.34, 0.34, 0.38, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 8

[node name="SgfMetadataPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_script")

[node name="UnsavedConfirmation" type="ConfirmationDialog" parent="."]
title = "棋谱信息已修改"
dialog_text = "棋谱信息已经发生改变，是否保留编辑内容？"
ok_button_text = "保留"
cancel_button_text = "放弃"

[node name="ErrorDialog" type="AcceptDialog" parent="."]
title = "更新失败"
ok_button_text = "确定"

[node name="Panel" type="PanelContainer" parent="."]
offset_right = 360.0
offset_bottom = 480.0
mouse_filter = 0
theme_override_styles/panel = SubResource("StyleBoxPanel")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="Content" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Panel/Margin/Content"]
