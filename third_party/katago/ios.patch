+  serverThreadsIsUsingFP16[serverThreadIdx] = 0;
+  if(serverThreadStartupException == nullptr)
+    serverThreadStartupException = error;
+  numServerThreadsStartingUp--;
+  if(numServerThreadsStartingUp <= 0)
+    mainThreadWaitingForSpawn.notify_all();
+  return true;
