+bool NNEvaluator::reportServerThreadStartupFailure(
+  int serverThreadIdx,
+  std::exception_ptr error
+) {
+  lock_guard<std::mutex> lock(bufferMutex);
+  if(serverThreadIdx < 0 || serverThreadIdx >= (int)serverThreadsIsUsingFP16.size() ||
+     serverThreadsIsUsingFP16[serverThreadIdx] != -1)
+    return false;
+
+  serverThreadsIsUsingFP16[serverThreadIdx] = 0;
+  if(serverThreadStartupException == nullptr)
+    serverThreadStartupException = error;
+  numServerThreadsStartingUp--;
+  if(numServerThreadsStartingUp <= 0)
+    mainThreadWaitingForSpawn.notify_all();
+  return true;
